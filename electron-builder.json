{
  "appId": "cn.sdu.breadboard",
  "productName": "SDU-BreadBoard",
  "asar": true,
  "directories": {
    "output": "releases/desktop"
  },
  "files": [
    "desktop/**/*",
    "index.html",
    "application.js",
    "styles/**/*",
    "vendor/**/*",
    "assets/**/*",
    "examples/**/*",
    "docs/**/*",
    "README.md",
    "LICENSE",
    "package.json",
    "!node_modules/dompurify/**/*",
    "!node_modules/elkjs/**/*",
    "!node_modules/libavoid-js/**/*",
    "!node_modules/marked/**/*"
  ],
  "win": {
    "icon": "desktop/icon.png",
    "target": [
      { "target": "nsis", "arch": ["x64"] },
      { "target": "portable", "arch": ["x64"] }
    ],
    "signExecutable": false
  },
  "nsis": {
    "artifactName": "SDU-BreadBoard-${version}-Setup-x64.exe",
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "SDU 面包板",
    "deleteAppDataOnUninstall": false
  },
  "portable": {
    "artifactName": "SDU-BreadBoard-${version}-Portable-x64.exe",
    "useZip": true
  },
  "publish": {
    "provider": "github",
    "owner": "Windy-Field",
    "repo": "SDU-BreadBoard",
    "vPrefixedTagName": false,
    "releaseType": "release"
  }
}
